{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bash tool/vercel_install.sh",
  "buildCommand": "bash tool/vercel_build.sh",
  "outputDirectory": "build/web",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), geolocation=(self), camera=()"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/:file(index\\.html|flutter_bootstrap\\.js|flutter\\.js|main\\.dart\\.js|main\\.dart\\.wasm|main\\.dart\\.mjs|manifest\\.json|version\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/:dir(canvaskit|icons)/:rest*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/:rest*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/:dir(fonts|packages)/:rest*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/models/:rest*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/eonet.mjs": {
      "maxDuration": 30
    },
    "api/nasa.mjs": {
      "maxDuration": 30
    },
    "api/apod.mjs": {
      "maxDuration": 30
    },
    "api/gemini.mjs": {
      "maxDuration": 30
    },
    "api/stats.mjs": {
      "maxDuration": 30
    },
    "api/tts.mjs": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "assets/voices/vi/**"
    },
    "api/osm.mjs": {
      "maxDuration": 30
    }
  }
}
