{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), geolocation=(self), camera=()"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/:file(index\\.html|flutter_bootstrap\\.js|flutter\\.js|main\\.dart\\.js|main\\.dart\\.wasm|main\\.dart\\.mjs|manifest\\.json|version\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/:rest*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/:dir(canvaskit|icons)/:rest*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/eonet.mjs": {
      "maxDuration": 30
    },
    "api/nasa.mjs": {
      "maxDuration": 30
    },
    "api/apod.mjs": {
      "maxDuration": 30
    },
    "api/gemini.mjs": {
      "maxDuration": 30
    },
    "api/stats.mjs": {
      "maxDuration": 30
    },
    "api/tts.mjs": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "_tts/vi/**"
    }
  }
}
